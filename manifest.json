{
    "manifest_version": 3,
    "name": "ScreenGrabber",
    "version": "1.0",
    "description": "Takes a screenshot of the active tab every 5 minutes.",
    "permissions": [
        "activeTab",
        "tabs",
        "storage",
        "alarms",
        "downloads"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "images/icon16.png",
            "48": "images/icon48.png",
            "128": "images/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "images/icon16.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "screengrabber@example.com",
            "strict_min_version": "115.0"
        }
    }
}